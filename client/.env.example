# -----------------------------------------------------------------------------
# ProLinker web client — copy to `.env.local`.
# Everything prefixed VITE_ is PUBLIC (bundled into the browser).
# NEVER put the service-role / secret key here.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# New projects: sb_publishable_... (legacy projects may use VITE_SUPABASE_ANON_KEY instead)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# API base URL. In development leave as /api/v1 (Vite proxies it to the server).
# In production set the full URL, e.g. https://api.prolinker.pk/api/v1
VITE_API_URL=/api/v1

# Dev only: where the Vite proxy forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:4000

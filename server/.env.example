# -----------------------------------------------------------------------------
# ProLinker API — copy to `.env` and fill in. NEVER commit the real file.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# New names shown; legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SERVER ONLY. Bypasses RLS. Never expose to the client or commit it.
SUPABASE_SECRET_KEY=your-secret-key

# Optional: only for projects still on the legacy HS256 JWT secret.
# Leave empty to verify tokens with the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the API (Render/Railway: 1). 0 locally.
TRUST_PROXY=0

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Demo seed (`npm run seed:users`) — used only in development
SEED_DEMO_PASSWORD=
